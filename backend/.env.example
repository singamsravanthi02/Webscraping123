#########################################
# AI
#########################################

GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH_LITE=gemini-flash-lite-latest
AI_PROVIDER=AUTO
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PREFERRED_MODELS=mistral,llama3.2
AI_REQUEST_TIMEOUT_SECONDS=60
AI_RETRY_ATTEMPTS=2
AI_CACHE_TTL_SECONDS=300

#########################################
# EMAIL (Brevo)
#########################################

BREVO_API_KEY=your_brevo_api_key_here

EMAIL_FROM=noreply@spip.local
EMAIL_FROM_NAME=SPIP

#########################################
# DATABASE
#########################################

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spip

#########################################
# REDIS
#########################################

REDIS_URL=redis://localhost:6379/0

#########################################
# CELERY
#########################################

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

#########################################
# JWT
#########################################

JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

#########################################
# SECURITY
#########################################

APP_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET
ENCRYPTION_KEY=CHANGE_ME_TO_RANDOM_ENCRYPTION_KEY

#########################################
# QDRANT
#########################################

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here

#########################################
# FRONTEND
#########################################

FRONTEND_URL=http://localhost:3000
ENABLE_EMAIL_VERIFICATION=false
ENABLE_GOOGLE_AUTH=false
ENABLE_FORGOT_PASSWORD=false

#########################################
# JOB PROVIDERS
#########################################

ARBEITNOW_ENABLED=true
REMOTEOK_ENABLED=true

#########################################
# APPLICATION
#########################################

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
